# LitBuy AI / site (copy to .env.local — never commit secrets)

# Vercel AI Gateway (required for LLM chat; catalogue search works without it)
AI_GATEWAY_API_KEY=
# Validated model ids — defaults applied when empty/invalid
AI_PRIMARY_MODEL=openai/gpt-4o-mini
AI_FALLBACK_MODEL=openai/gpt-4o
AI_EMBEDDING_MODEL=

# Limits (optional)
AI_MAX_OUTPUT_TOKENS=1200
AI_DAILY_REQUEST_LIMIT=800
AI_RATE_LIMIT_PER_MINUTE=12
AI_RATE_LIMIT_PER_DAY=80
AI_MAX_HISTORY_MESSAGES=16
AI_MAX_PROMPT_CHARS=1200
AI_MAX_TOOL_CALLS=6
AI_MAX_PRODUCTS=12

# Cron protection for /api/ai/cron/* and admin diagnostic APIs
# (/api/catalog/audit, /api/analytics/summary) — REQUIRED in production
CRON_SECRET=

# Optional admin alias — unused; admin routes reuse CRON_SECRET bearer auth
# ADMIN_API_SECRET=

# Public site URL
NEXT_PUBLIC_SITE_URL=https://litbuyfinds.io

# ---------------------------------------------------------------------------
# Catalog image CDN mirror (Vercel Blob — REQUIRED for images:mirror uploads)
# ---------------------------------------------------------------------------
# 1) Vercel Dashboard → Project → Storage → Create Database → Blob
# 2) Access: Public
# 3) Connect the store to this project (Production + Preview + Development)
# 4) Copy the generated token into Vercel env + local .env.local:
#
# BLOB_READ_WRITE_TOKEN=
#
# Do NOT commit the token. Runtime page loads use public blob URLs from
# src/data/image-mirror-map.json and do not need the token.
# After configuring, run: npm run images:mirror -- --dry-run
# then: npm run images:mirror
# ---------------------------------------------------------------------------
